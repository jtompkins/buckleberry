package shared

import "buckleberry/internal/settings"

templ LinkdingSettingsPartial(settings *settings.LinkdingSettings) {
	{{
		// Onboarding renders this partial with no settings to show yet.
		data := map[string]bool{
			"useLinkding": settings != nil && settings.UseLinkding,
		}
	}}
	<div id="linkding-settings" x-data={ templ.JSONString(data) }>
		<h2>Linkding Connection</h2>
		<p>
			<label>
				<input
					type="checkbox"
					name="use-linkding"
					x-model="useLinkding"
				/>
				Connect to Linkding?
			</label>
		</p>
		<div x-show="useLinkding">
			<p>
				<label for="linkding-instance-url">Instance URL</label>
				<input
					type="text"
					name="linkding-instance-url"
					placeholder="http://my-instance.linkding.com"
					if settings != nil && settings.LinkdingInstanceURL != nil {
						value={ *settings.LinkdingInstanceURL }
					}
					x-bind:required="useLinkding"
				/>
			</p>
			<p>
				<label for="linkding-api-key">Linkding API Key</label>
				<input
					type="text"
					name="linkding-api-key"
					if settings != nil && settings.LinkdingAPIKey != nil {
						value={ *settings.LinkdingAPIKey }
					}
					x-bind:required="useLinkding"
				/>
			</p>
		</div>
	</div>
}
