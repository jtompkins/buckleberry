package wallabag

templ WallabagSettingsPartial(settings *WallabagSettings) {
	<h2>Wallabag Connection</h2>
	<p>
		<label for="wallabag-url">Instance URL</label>
		<input
			type="text"
			name="wallabag-url"
			placeholder="http://my-instance.wallabag.com"
			required
			if settings != nil && settings.WallabagInstanceURL != nil {
				value={ *settings.WallabagInstanceURL }
			}
		/>
	</p>
	<p>
		<label for="wallabag-username">Username</label>
		<input
			type="text"
			name="wallabag-username"
			placeholder="username"
			required
			if settings != nil && settings.WallabagUsername != nil {
				value={ *settings.WallabagUsername }
			}
		/>
	</p>
	<p>
		<label for="wallabag-password">Password</label>
		<input
			type="password"
			name="wallabag-password"
			placeholder="password"
			required
			if settings != nil && settings.WallabagPassword != nil {
				value={ *settings.WallabagPassword }
			}
		/>
	</p>
	<p>
		<label for="wallabag-client-id">Client ID</label>
		<input
			type="text"
			name="wallabag-client-id"
			placeholder="client id"
			required
			if settings != nil && settings.WallabagClientID != nil {
				value={ *settings.WallabagClientID }
			}
		/>
	</p>
	<p>
		<label for="wallabag-client-secret">Client Secret</label>
		<input
			type="password"
			name="wallabag-client-secret"
			placeholder="client secret"
			required
			if settings != nil && settings.WallabagClientSecret != nil {
				value={ *settings.WallabagClientSecret }
			}
		/>
	</p>
}
